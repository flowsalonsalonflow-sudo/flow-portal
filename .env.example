# ============================================================================
# KONFIGURASI SERVER VPS FLOW SALON & ROBOT POS KLUTO (my.kluto.id)
# Salin file ini menjadi `.env` di VPS Anda lalu isi datanya
# ============================================================================

# Port Node.js di VPS (default: 3001)
PORT=3001

# Domain publik aplikasi Anda di VPS (tanpa garis miring di akhir)
PUBLIC_BASE_URL=https://app.flowsalon.id/absen

# URL Google Apps Script Web App (sebagai jembatan sinkronisasi Google Sheets)
GAS_URL=https://script.google.com/macros/s/AKfycby7_TYAxQcEhY9qDb2MhtIWaigpzyG08FnYTuRvlzTLrn_H-2zNdDVqJljL403PxoBJOw/exec

# Akun Login Dashboard POS Kluto (https://my.kluto.id) untuk Robot Tengah Malam (00:05 WIB)
KLUTO_BASE_URL=https://my.kluto.id
KLUTO_USERNAME=isi_username_kluto_anda
KLUTO_PASSWORD=isi_password_kluto_anda

# Opsional untuk Frontend Vite jika ingin langsung mengarah ke endpoint lokal VPS:
# VITE_BACKEND_URL=/absen/api/backend
